# Optional TURN relay configuration. Keep credentials out of source control.
# JSON array of RTCIceServer objects: urls, username, credential.
ICE_SERVERS_JSON=

# LiveKit Cloud (recommended for reliable group voice, camera, and screen sharing).
# Generate a service-account key in the LiveKit project settings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required to enforce email verification during registration and every login.
# AUTH_EMAIL_FROM must be a sender verified by Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Aemeath <login@example.com>
